#!/bin/sh
# pre-commit | moranteam market data guard (rule adopted 2026-09-22, text checks added 2026-09-22,
#              text checks limited to added lines, --range, keys, allowlist, pre-push 2026-09-23)
# Blocks commits that add market research data to any repo:
#   lease comps, tenant demand (tenants in the market, requirements lists),
#   market statistics and research reports (CBRE Research, MarketIQ, CoStar, VTS exports),
#   availability data, and files copied directly from OneDrive.
# Code, skills, instructions, client names, and deal terms are fine.
#
# Two kinds of checks:
#   HARD: data files named like market data, export headers in data files, OneDrive copies.
#         Always block.
#         HARD checks always read the whole file.
#   TEXT: the lines a commit adds to any text file, .md and code included, are scanned for
#         market statistics written into prose or code (vacancy, absorption, availability,
#         comps, asking rent per SF, SF counts next to vacant or leased). Only added lines are
#         checked (staged diff, rename detection on): a pure rename adds nothing, a brand new
#         file is all added lines, and lines a commit leaves alone are not re-checked. Hits
#         block unless the person running the commit sets MARKET_GUARD_OVERRIDE=1, which
#         prints the hits and lets it through. The override is refused under Claude Code:
#         any process Claude Code starts carries CLAUDECODE, and then the override is ignored.
#         Deal terms (base rent, TI, free rent, escalations in counters and LOIs) pass.
#   KEYS: added lines that carry an Airtable personal access token or a Google API key block
#         (HARD, never overridable); the value is never printed.
# Allowlist: .githooks/market-guard-allow.txt, one 'path | rule label' per line, waives that
#         one TEXT or export header rule for that one path (never file names, OneDrive copies,
#         or keys). --range reads it from the pushed tip and warns on any commit that changes it.
# Modes:
#   (no arguments)            git runs it as the pre-commit hook on the staged changes.
#   --range <before> <after>  scans every commit in a pushed range, each against its first
#                             parent (the GitHub Actions workflow uses this). A zero or missing
#                             <before> means a new branch: in Actions (GITHUB_REF_NAME set) it
#                             scans the commits not already on another branch of the repo; run
#                             by hand it scans every commit reachable from <after> (full audit).
#                             Reports commit, file, line, and rule only, never the matched text,
#                             and ignores the override.
#   --commits <sha>...        scans exactly these commits (the pre-push hook uses this; the
#                             override behaves as in pre-commit).
# Local hooks and the Claude Code guard are friction, not enforcement: anyone can skip them.
# The GitHub Actions scan and the repository rulesets are the only enforcement.
# Enable per clone:  git config core.hooksPath .githooks
exec python3 - "$@" <<'PYEOF'
import os, re, subprocess, sys, time

DATA_EXT = {'.pdf', '.xlsx', '.xls', '.xlsm', '.csv', '.tsv', '.json', '.log', '.txt', '.parquet',
            '.gz', '.zip', '.docx', '.pptx', '.html', '.htm'}
CONTENT_EXT = {'.csv', '.tsv', '.json', '.txt', '.log', '.html', '.htm', '.xml'}
SKIP_TEXT = re.compile(r'(^|/)(\.githooks/|package-lock\.json$|yarn\.lock$|pnpm-lock\.yaml$|node_modules/|venv/|\.venv/)')
NAME = re.compile(r'comp(s|set|_set| set)?\b|lease.?(comps|transactions)|availab|avails\b|tenants?.?in.?(the.?)?market'
                  r'|requirements?.?list|tenant.?demand|demand.?data|market.?(report|stats|statistics|survey|data|view)'
                  r'|marketiq|market.?iq|costar|vts.?(export|import)|figures.?q[1-4]|q[1-4].?\d{2,4}.*figures'
                  r'|snapshot.?q[1-4]|quarter.?end.?presentation|research.?report|brochure|onedrive', re.I)
# Export headers are matched case sensitive: real exports use these exact column titles,
# while code that maps column names (lowercase strings) is not data. Two column titles must be
# separated by table delimiters only (comma, tab, pipe, or an HTML cell boundary, with at most a
# few other column titles between them), so UI labels and messages in scripts do not match.
SEP = r'(?:\s*(?:[,\t|]|</t[hd]>\s*<t[hd][^>]*>)\s*)'
CELL = r'[^,\t|<>\n]{0,40}'
def header(a, b):
    return re.compile('(?:' + a + ')(?:' + SEP + CELL + '){0,10}?' + SEP + '(?:' + b + ')')
CONTENT = [
    ('CoStar export header', re.compile(r'PropertyID|Building Class.{0,80}RBA|Total Available Space \(SF\)|Percent Leased')),
    ('lease comp table', header(r'Sign(?:ed)? Date|Lease Sign Date', r'Starting Rent|Effective Rent|Free Rent|TI Allowance')),
    ('VTS export header', header(r'Deal Stage', r'Tenant Name|Requirement Size|Proposal Date')),
    ('research report marker', re.compile(r'MarketView|CBRE Research|Figures \| Q[1-4]|MarketIQ', re.I)),
    ('availability table', header(r'Available SF|SF Available|Direct Available|Sublease Available', r'Asking Rent|Rate|Available Date')),
    ('tenants in market list', re.compile(r'tenants in (the )?market|active requirements?', re.I)),
]

# TEXT checks: market statistics written into any text file.
NUM = r'[~+\-−(]?\d[\d,]*(?:\.\d+)?'
PCT = NUM + r'\s?%'
SFN = NUM + r'\s?(?:[KkMm]\s?)?(?:R?SF|RSF|msf|MSF|sf)\b'
RATE = r'\$\s?\d+(?:\.\d+)?\s?(?:/\s?(?:R?SF|sf|RSF)(?:/\s?(?:mo|yr|month|year))?|\s?(?:NNN|FSG|FS|IG|MG)\b)'
MARKET = r'(?:vacan\w*|occupan\w*|absorption|availability rate|submarket|asking rents?|asking rates?|market rents?|lease comps?|\bcomps?\b|\bcomp set\b)'
TEXT = [
    ('vacancy or occupancy figure', re.compile(r'(?:vacan\w*|occupan\w*|leased\b|availability rate)[^\n]{0,40}?' + PCT + '|' + PCT + r'[^\n]{0,15}?(?:vacan\w*|occupan\w*|occupied|leased\b)', re.I)),
    ('absorption figure', re.compile(r'absorption[^\n]{0,40}?(?:' + SFN + '|' + NUM + r'\s?[KkMm]\b|' + PCT + ')|(?:' + SFN + '|' + NUM + r'\s?[KkMm]\b)[^\n]{0,20}?(?:net )?absorption', re.I)),
    ('SF count next to vacant, available, or absorbed', re.compile(SFN + r'[^\n]{0,25}?\b(?:vacant|available|availability|absorbed|under construction|delivered|sublease available)\b|\b(?:vacant|available|under construction)\b[^\n]{0,15}?' + SFN, re.I)),
    ('asking or market rent figure', re.compile(r'(?:asking|average|avg|market|submarket|class [abc])\b[^\n]{0,30}?(?:rents?|rates?)[^\n]{0,30}?' + RATE, re.I)),
    ('lease comp line (tenant, SF, and rent per SF)', re.compile(SFN + r'[^\n]{0,60}?' + RATE + '|' + RATE + r'[^\n]{0,60}?' + SFN)),
    ('comp or availability table', None),
]
KEYS = [
    ('Airtable personal access token', re.compile(r'pat[A-Za-z0-9]{14}\.[a-f0-9]{64}')),
    ('Google API key', re.compile(r'AIza[0-9A-Za-z_\-]{35}')),
]
DEAL_TERMS = re.compile(r'base rent|\bTI\b|tenant improvement|free rent|abatement|escalat|\bLOI\b|counter|proposal|premises|commencement|renewal option|security deposit', re.I)
MARKET_WORD = re.compile(MARKET, re.I)
TABLE_HEAD = re.compile(r'tenant|lessee|occupier|building|address|property', re.I)
TABLE_SIZE = re.compile(r'\b(?:R?SF|size|square feet|avail\w*)\b', re.I)
TABLE_RATE = re.compile(r'rent|rate|asking|\$/\s?sf|vacan', re.I)

def table_hits(text):
    """Markdown, CSV, or TSV tables whose header names a tenant or building, a size, and a rent or vacancy
    column, followed by at least two rows that carry an SF count, a percentage, or a dollar figure."""
    hits = []
    lines = text.splitlines()
    for i, line in enumerate(lines):
        cells = re.split(r'\s*[|,\t]\s*', line.strip().strip('|'))
        if len(cells) < 3:
            continue
        head = ' '.join(cells)
        if not (TABLE_HEAD.search(head) and TABLE_SIZE.search(head) and TABLE_RATE.search(head)):
            continue
        rows = 0
        for nxt in lines[i + 1:i + 30]:
            if not re.search(r'[|,\t]', nxt):
                break
            if re.search(r'\d[\d,]{3,}|\d%|\$\s?\d', nxt):
                rows += 1
        if rows >= 2 and not DEAL_TERMS.search(head):
            hits.append((i + 1, line.strip()[:90]))
    return hits

def text_hits(text, numbers=None):
    """Scan text. numbers, when given, maps each line of text (in order) to its real line number."""
    found = []
    real = (lambda i: numbers[i - 1]) if numbers else (lambda i: i)
    for n, line in enumerate(text.splitlines(), 1):
        deal_line = DEAL_TERMS.search(line) and not MARKET_WORD.search(line)
        for label, rx in TEXT:
            if rx is None:
                continue
            if deal_line and label.startswith(('lease comp line', 'asking or market')):
                continue
            if deal_line and label.startswith('SF count') and not re.search(r'vacant|absorbed', line, re.I):
                continue
            m = rx.search(line)
            if m:
                found.append((label, real(n), m.group(0).strip()[:70]))
                break
    for n, snippet in table_hits(text):
        found.append(('comp or availability table', real(n), snippet))
    return found

_ADDED = None

def added_lines(p):
    """Lines this commit adds to path p: (new line numbers, text). The whole staged diff is read
    once with rename detection (a pathspec would hide the rename source), so a pure rename adds
    nothing and a new file with no rename source is all added lines."""
    global _ADDED
    if _ADDED is None:
        _ADDED = {}
        out = subprocess.run(['git', '-c', 'core.quotePath=false', 'diff', '--cached', '-M', '--unified=0',
                              '--no-color', '--no-ext-diff', '--diff-filter=ACMR'],
                             capture_output=True).stdout.decode('utf-8', 'ignore')
        cur, n = None, 0
        for line in out.splitlines():
            if line.startswith('diff --git '):
                cur = None
            elif line.startswith('+++ '):
                cur = line[6:].rstrip('\t') if line.startswith('+++ b/') else None
                if cur is not None:
                    _ADDED.setdefault(cur, ([], []))
            elif line.startswith('@@'):
                m = re.search(r'\+(\d+)', line)
                n = int(m.group(1)) if m else 0
            elif cur is not None and line.startswith('+'):
                _ADDED[cur][0].append(n)
                _ADDED[cur][1].append(line[1:])
                n += 1
    numbers, lines = _ADDED.get(p, ([], []))
    return numbers, '\n'.join(lines)

def staged():
    out = subprocess.run(['git', 'diff', '--cached', '-M', '--name-only', '--diff-filter=ACMR', '-z'],
                         capture_output=True).stdout.decode()
    return [p for p in out.split('\0') if p]

def blob(p):
    return subprocess.run(['git', 'show', f':{p}'], capture_output=True).stdout

def onedrive_index():
    root = os.path.expanduser('~/Library/CloudStorage/OneDrive-CBRE,Inc')
    cache = os.path.expanduser('~/.claude/cache/onedrive-name-size.txt')
    if not os.path.isdir(root):
        return set()
    if not os.path.isfile(cache) or time.time() - os.path.getmtime(cache) > 86400:
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        rows = []
        for dp, dn, fn in os.walk(root):
            for f in fn:
                try:
                    rows.append(f"{f.lower()}\t{os.stat(os.path.join(dp, f)).st_size}")
                except OSError:
                    pass
        open(cache, 'w').write('\n'.join(rows))
    return set(open(cache).read().splitlines())

_OD = None
ALLOW_FILE = '.githooks/market-guard-allow.txt'

def load_allow(rev=None):
    """Allowlist entries (path, rule) from .githooks/market-guard-allow.txt, one per line as
    'path | rule label'. rev None reads the staged copy (pre-commit); otherwise the copy in rev."""
    spec = f'{rev}:{ALLOW_FILE}' if rev else f':{ALLOW_FILE}'
    text = subprocess.run(['git', 'show', spec], capture_output=True).stdout.decode('utf-8', 'ignore')
    if not text and not rev and os.path.isfile(ALLOW_FILE):
        text = open(ALLOW_FILE, encoding='utf-8').read()
    out = set()
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith('#') and '|' in line:
            path, rule = (x.strip() for x in line.split('|', 1))
            out.add((path, rule))
    return out

def check_file(p, data, numbers, added, show_text=True, allow=frozenset()):
    """All checks for one file. Returns (hard, soft) lists of (path, reason). An allowlist entry
    (path, rule) waives that TEXT rule or export header rule for that path only; file name,
    OneDrive, and key checks can never be waived."""
    global _OD
    hard, soft = [], []
    base = os.path.basename(p)
    ext = os.path.splitext(base)[1].lower()
    is_text = b'\0' not in data[:8000]
    if ext in DATA_EXT and NAME.search(base):
        hard.append((p, 'file name looks like market data'))
    if ext in CONTENT_EXT and is_text:
        text = data.decode('utf-8', 'ignore')
        for label, rx in CONTENT:
            if rx.search(text) and (p, label) not in allow:
                hard.append((p, label))
                break
    if ext in DATA_EXT or not is_text:
        if _OD is None:
            _OD = onedrive_index()
        if f"{base.lower()}\t{len(data)}" in _OD:
            hard.append((p, 'identical name and size to a file in OneDrive (copied directly from OneDrive)'))
    if is_text and numbers:
        for k, line in enumerate(added.splitlines()):
            for label, rx in KEYS:
                if rx.search(line):
                    hard.append((p, f'line {numbers[k]}: {label} (value not shown)'))
        if not SKIP_TEXT.search(p):
            for label, line, snippet in text_hits(added, numbers):
                if (p, label) in allow:
                    continue
                soft.append((p, f'line {line}: {label}' + (f': "{snippet}"' if show_text else '')))
    return hard, soft

def diff_added(a, b):
    """Added lines per path between two commits (rename aware), like added_lines for the index."""
    out = subprocess.run(['git', '-c', 'core.quotePath=false', 'diff', '-M', '--unified=0', '--no-color',
                          '--no-ext-diff', '--diff-filter=ACMR', a, b],
                         capture_output=True).stdout.decode('utf-8', 'ignore')
    res, cur, n = {}, None, 0
    for line in out.splitlines():
        if line.startswith('diff --git '):
            cur = None
        elif line.startswith('+++ '):
            cur = line[6:].rstrip('\t') if line.startswith('+++ b/') else None
            if cur is not None:
                res.setdefault(cur, ([], []))
        elif line.startswith('@@'):
            m = re.search(r'\+(\d+)', line)
            n = int(m.group(1)) if m else 0
        elif cur is not None and line.startswith('+'):
            res[cur][0].append(n)
            res[cur][1].append(line[1:])
            n += 1
    return res

EMPTY_TREE = '4b825dc642cb6eb9a060e54bf8d69288fbee4904'

def git_out(*a):
    return subprocess.run(['git', *a], capture_output=True, text=True).stdout

def scan_commits(commits, allow):
    """Run every check on the lines each commit adds against its first parent. Returns (hard, soft)
    lists of (commit, path, reason)."""
    hard, soft = [], []
    for c in commits:
        parents = git_out('rev-list', '--parents', '-n', '1', c).split()[1:]
        parent = parents[0] if parents else EMPTY_TREE
        for p, (numbers, lines) in diff_added(parent, c).items():
            if p.startswith('.githooks/'):
                continue
            data = subprocess.run(['git', 'show', f'{c}:{p}'], capture_output=True).stdout
            h, s = check_file(p, data, numbers, '\n'.join(lines), show_text=False, allow=allow)
            hard += [(c, path, why) for path, why in h]
            soft += [(c, path, why) for path, why in s]
    return hard, soft

def run_range(before, after):
    """GitHub Actions: every commit in before..after. New branch (zero before) in Actions: only the
    commits no other branch holds; by hand: the full history of after. Override never applies."""
    zero = not before or set(before) == {'0'} or not git_out('cat-file', '-t', before).strip()
    branch = os.environ.get('GITHUB_REF_NAME', '') if os.environ.get('GITHUB_EVENT_NAME') == 'push' else ''
    if not zero:
        revs = git_out('rev-list', '--reverse', f'{before}..{after}')
    elif branch:
        others = [r for r in git_out('for-each-ref', '--format=%(refname)', 'refs/remotes/origin').split()
                  if r not in (f'refs/remotes/origin/{branch}', 'refs/remotes/origin/HEAD')]
        revs = git_out('rev-list', '--reverse', after, '--not', *others) if others else git_out('rev-list', '--reverse', after)
    else:
        revs = git_out('rev-list', '--reverse', after)
    commits = revs.split()
    allow = load_allow(after)
    hard, soft = scan_commits(commits, allow)
    for c in commits:
        parents = git_out('rev-list', '--parents', '-n', '1', c).split()[1:]
        if git_out('diff', '--name-only', parents[0] if parents else EMPTY_TREE, c, '--', ALLOW_FILE).strip():
            print(f'::warning file={ALLOW_FILE}::market data guard: allowlist changed in commit {c[:12]}; review it')
    for c, path, why in hard + soft:
        m = re.match(r'line (\d+): (.*)', why)
        if m:
            print(f'::error file={path},line={m.group(1)}::market data guard: {m.group(2)} (commit {c[:12]})')
        else:
            print(f'::error file={path}::market data guard: {why} (commit {c[:12]})')
    print(f'market data guard: scanned {len(commits)} commit(s), {len(hard) + len(soft)} finding(s), {len(allow)} allowlist entr{"y" if len(allow) == 1 else "ies"}')
    return 1 if hard or soft else 0

def override_state():
    """The override applies only outside Claude Code: any process Claude Code starts carries CLAUDECODE."""
    requested = os.environ.get('MARKET_GUARD_OVERRIDE') == '1'
    under_claude = bool(os.environ.get('CLAUDECODE'))
    return requested and not under_claude, requested and under_claude

def report(hard, soft, where):
    override, refused = override_state()
    if hard:
        sys.stderr.write(f'\nBLOCKED by the market data guard ({where}):\n')
        for p, why in hard:
            sys.stderr.write(f'  {p}: {why}\n')
    if soft:
        head = 'WARNING (overridden with MARKET_GUARD_OVERRIDE=1)' if override else 'BLOCKED'
        sys.stderr.write(f'\n{head}: market statistics found in text ({where}):\n')
        for p, why in soft:
            sys.stderr.write(f'  {p}: {why}\n')
    if refused and (hard or soft):
        sys.stderr.write('\nMARKET_GUARD_OVERRIDE is ignored under Claude Code (CLAUDECODE is set).\n')
    if hard or (soft and not override):
        sys.stderr.write('\nMarket research data stays on OneDrive and in Supabase, never on GitHub.\n'
                         'Remove the figures (or unstage the file and add it to .gitignore).\n'
                         'Deal terms in counters and LOIs are fine. If a text hit is a false positive or a\n'
                         'made up example, Charlie can commit with MARKET_GUARD_OVERRIDE=1 git commit ...\n'
                         'in his own terminal. Claude never sets the override and never uses --no-verify.\n\n')
        return 1
    return 0

if len(sys.argv) >= 2 and sys.argv[1] == '--range':
    sys.exit(run_range(sys.argv[2] if len(sys.argv) > 2 else '', sys.argv[3] if len(sys.argv) > 3 else 'HEAD'))

if len(sys.argv) >= 2 and sys.argv[1] == '--commits':
    commits = [c for c in sys.argv[2:] if c]
    hard, soft = scan_commits(commits, load_allow('HEAD'))
    sys.exit(report([(f'{c[:12]} {p}', w) for c, p, w in hard], [(f'{c[:12]} {p}', w) for c, p, w in soft],
                    '.githooks/pre-push'))

hard, soft = [], []
allow = load_allow()
for p in staged():
    if p.startswith('.githooks/'):
        continue
    numbers, added = added_lines(p)
    h, t = check_file(p, blob(p), numbers, added, allow=allow)
    hard += h
    soft += t
sys.exit(report(hard, soft, '.githooks/pre-commit'))
PYEOF
